  // Personal setup: "local/devtools:2" is an image built on the maintainer's
  // machine and is not published. To use this elsewhere, replace "image" with
  // a public one such as "mcr.microsoft.com/devcontainers/typescript-node:24"
  // (PHP is also needed for the PHP comparison test).
{
  "name": "Seal Tracker",
  "image": "local/devtools:2",
  "forwardPorts": [8000, 5173],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",
        "mechatroner.rainbow-csv",
        "bmewburn.vscode-intelephense-client",
        "mrmlnc.vscode-apache",
        "openai.chatgpt@26.1007.21434"
      ]
    }
  },
  "runArgs": ["--shm-size=1g"],
  "mounts": [
    "source=${localWorkspaceFolder}/.git,target=${containerWorkspaceFolder}/.git,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer,target=${containerWorkspaceFolder}/.devcontainer,type=bind,readonly"
  ]
}
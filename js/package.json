{
  "name": "clan-seal-tracker-js",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/compile-data.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare:data",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "audit": "vitest run --config vitest.audit.config.ts",
    "audit:live": "node scripts/manifest-audit.mjs --check",
    "audit:update": "node scripts/manifest-audit.mjs --update",
    "pretest:browser": "npm run prepare:data",
    "test:browser": "playwright test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "fake-indexeddb": "^6.0.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0"
  }
}

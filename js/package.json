{
  "name": "clan-seal-tracker-js",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare:data": "node scripts/compile-data.mjs",
    "predev": "npm run prepare:data",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run prepare:data",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "audit": "vitest run --config vitest.audit.config.ts",
    "audit:live": "node scripts/manifest-audit.mjs --check",
    "audit:update": "node scripts/manifest-audit.mjs --update",
    "pretest:browser": "npm run prepare:data",
    "test:browser": "playwright test",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dexie": "^4.0.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.0.0",
    "wrangler": "4.160.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
